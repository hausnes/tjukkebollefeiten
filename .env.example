# Valfritt: nøkkelen som signerer innloggingskapslane. Utan denne lagar appen ein sjølv
# og lagrar han i fila «session-secret» ved sida av databasen.
# SESSION_SECRET=
PORT=3000
# Valfritt: kvar databasefila skal liggje (standard: data/tjukkebolle.db)
# DB_PATH=/var/lib/tjukkebolle/tjukkebolle.db
# Set til 1 dersom appen står bak ein omvend proxy (nginx, Caddy o.l.) som terminerer HTTPS
# TRUST_PROXY=1
